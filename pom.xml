<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>uk.co.raphel</groupId>
    <artifactId>railwaysim</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>RailwaySim</name>
    <description>Railway simulator: simulation server, config GUI and web display</description>

    <modules>
        <module>RailSimCommon</module>
        <module>RailsimConfigGUI</module>
        <module>Railsimserver</module>
        <module>RailsimWebApp</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>3.1.0</springdoc.version>
        <vaadin.version>25.0.6</vaadin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Inter-module dependency: modules omit the version and inherit this -->
            <dependency>
                <groupId>uk.co.raphel</groupId>
                <artifactId>railsimcommon</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Only Lombok is used by every module, so it is the only
         dependency declared here. Everything else belongs in the
         module that needs it. -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>
                <!-- The compiler plugin needs no explicit configuration:
                     spring-boot-starter-parent already wires Lombok's
                     annotation processor path when Lombok is present. -->
            </plugins>
        </pluginManagement>
    </build>

</project>
